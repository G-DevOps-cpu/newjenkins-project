pipeline {
    agent any
    tools { nodejs 'nodeproject' }
    options { timestamps(); timeout(time: 10, unit: 'MINUTES') }
    stages {
        stage('Tool versions') { steps { sh 'node --version && npm --version' } }
        stage('Test') { steps { sh 'mkdir -p reports && npm run test:ci' } }
    }
    post { always { junit 'reports/tests.xml' } }
}
